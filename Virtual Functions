# 1  Example Without Virtual Function ❌
#include <iostream>
using namespace std;

class Base {
public:
    void show() {
        cout << "Base class show function" << endl;
    }
};

class Derived : public Base {
public:
    void show() {
        cout << "Derived class show function" << endl;
    }
};

int main() {
    Base* b;
    Derived d;
    b = &d;
    b->show();   // Output?
}

  #OUTPUT
  Base class show function  // Base class show function




















  # 2 Example With Virtual Function ✅
    #include <iostream>
using namespace std;

class Base {
public:
    virtual void show() {
        cout << "Base class show function" << endl;
    }
};

class Derived : public Base {
public:
    void show() {
        cout << "Derived class show function" << endl;
    }
};

int main() {
    Base* b;
    Derived d;
    b = &d;
    b->show();   // Output?
}

  🔸 Output:
Derived class show function
👉 Runtime polymorphism achieved
